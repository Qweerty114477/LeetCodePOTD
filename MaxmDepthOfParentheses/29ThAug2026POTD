class Solution {
    public int maxDepth(String s) {
        int n=s.length();
        int maxm=0;
        int cnt=0;
        for(int i=0;i<n;i++){
            char c=s.charAt(i);
            if(c=='('){
                cnt++;
            }
            else if(c==')'){
                cnt--;
            }
            maxm=Math.max(maxm,cnt);
        }
        return maxm;
    }
}
